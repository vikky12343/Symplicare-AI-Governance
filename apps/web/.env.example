# Development only. Copy to apps/web/.env.
#
# Where `npm run dev` proxies /api. Unset, it uses the API running locally on
# port 4000. Point it at a deployed API to develop the front end against real
# data:
#
#   API_ORIGIN=https://symplicare-ai-governance-backend.onrender.com
#
# This has no effect on a production build. The built bundle contains no API
# hostname — the browser calls /api on whatever origin served the page, and
# the host's rewrite rule decides where that goes.
API_ORIGIN=http://localhost:4000
