# Copy to apps/api/.env for local development.
# Every value here is optional in development and required in production.

NODE_ENV=development
PORT=4000

# Leave MONGODB_URI unset to run an in-process MongoDB that stores its data in
# apps/api/.mongo-data. Production refuses to start without a real one.
# MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas. Replace <password> with the database user's password — not the
# user name — and percent-encode it if it contains : / ? # [ ] @
# MONGODB_URI=mongodb+srv://user:<password>@cluster.mongodb.net/?retryWrites=true&w=majority   # secret-scan-ignore: documentation placeholder
MONGODB_DB=care_governance

# Signs session cookies. Required in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=
SESSION_TTL_HOURS=12

WEB_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=5242880
LOG_LEVEL=info

# Where evidence files are written. Unset, they go to .storage beside the
# working directory. On a host whose filesystem does not survive a deploy this
# must point at a mounted volume, or the evidence is silently discarded.
# STORAGE_DIR=/var/data/evidence
